# ==============================================================================
# Stellar Game Studio - Environment Configuration Example
# ==============================================================================
# Copy this file to .env or run `bun run setup` to automatically generate it.
# WARNING: Never commit .env containing private keys to version control!

# ------------------------------------------------------------------------------
# Stellar / Soroban Network Settings (Testnet Default)
# ------------------------------------------------------------------------------
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VITE_FRIENDBOT_URL=https://friendbot.stellar.org

# ------------------------------------------------------------------------------
# Core Contracts (Stellar Testnet)
# ------------------------------------------------------------------------------
# Mock / Canonical Game Hub contract address
VITE_GAME_HUB_CONTRACT_ID=CB4VZAT2U3UC6XFK3N23SKRF2NDCMP3QHJYMCHHFMZO7MRQO6DQ2EMYG
VITE_MOCK_GAME_HUB_CONTRACT_ID=CB4VZAT2U3UC6XFK3N23SKRF2NDCMP3QHJYMCHHFMZO7MRQO6DQ2EMYG

# ------------------------------------------------------------------------------
# Deployed Game Contract IDs
# (Populated automatically by `bun run deploy` or `bun run setup`)
# ------------------------------------------------------------------------------
VITE_NUMBER_GUESS_CONTRACT_ID=
VITE_TWENTY_ONE_CONTRACT_ID=
VITE_DICE_DUEL_CONTRACT_ID=

# ------------------------------------------------------------------------------
# Local Development Wallets (Testnet)
# ------------------------------------------------------------------------------
# You can generate testnet keypairs with:
#   stellar keys generate dev-admin --network testnet
#   stellar keys fund dev-admin --network testnet
# Or via Stellar Laboratory: https://laboratory.stellar.org/#account-creator?network=test
VITE_DEV_ADMIN_ADDRESS=
VITE_DEV_PLAYER1_ADDRESS=
VITE_DEV_PLAYER2_ADDRESS=

# Dev wallet secret keys for local automated testing (NEVER USE IN PRODUCTION!)
VITE_DEV_PLAYER1_SECRET=
VITE_DEV_PLAYER2_SECRET=
